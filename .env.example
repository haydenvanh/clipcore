# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:port/dbname"
DIRECT_URL="postgresql://user:password@host:port/dbname"

# ─── Auth (NextAuth) ─────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_here"

GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ─── Clipping provider (MuAPI) ───────────────────────────────────────────────
AICLIPS_API_KEY="your_muapi_key"
# Public base URL the provider calls back on, e.g. https://clipcore.app
WEBHOOK_URL="http://localhost:3000"
# REQUIRED. Shared secret appended to the provider callback URL and verified on
# the way in. Without it /api/webhook/muapi rejects every callback (fail-closed).
# openssl rand -hex 32
MUAPI_WEBHOOK_SECRET="your_muapi_webhook_secret"

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Recurring price ids, created in the Stripe dashboard. Required — checkout
# refuses a plan whose price id is not configured, rather than guessing.
STRIPE_PRICE_BASIC="price_..."   # $9.99  / 150 credits
STRIPE_PRICE_PRO="price_..."     # $14.99 / 300 credits
STRIPE_PRICE_ULTRA="price_..."   # $29.99 / 800 credits

# ─── UI ──────────────────────────────────────────────────────────────────────
# One of: slate-indigo, cyberpunk, emerald, sunset, midnight
NEXT_PUBLIC_THEME=slate-indigo
