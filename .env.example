# ClipCore — private, single-user tool. Copy to .env and fill in.
# Run `npm run doctor` afterwards to check everything is set.

# ─── Required ────────────────────────────────────────────────────────────────

# Postgres. A free Neon project works (neon.tech), or a local Postgres.
# DATABASE_URL is used by the app; DIRECT_URL (unpooled) by migrations.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Whisper transcription. platform.openai.com/api-keys
# Costs about $0.006 per minute of video.
OPENAI_API_KEY="sk-..."

# Picks the best moments. console.anthropic.com
# Costs roughly $0.10 per hour of video.
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Optional ────────────────────────────────────────────────────────────────

# Where clips and source videos are stored. Defaults to ./.storage
# LOCAL_STORAGE_DIR=".storage"

# Model used to choose moments. Defaults to claude-opus-5.
# CLIPCORE_ANALYSIS_MODEL="claude-opus-5"

# Jobs processed at once. Each render is CPU-heavy; 2 suits most laptops.
# WORKER_CONCURRENCY=2

# Point transcription at a self-hosted Whisper-compatible server instead.
# WHISPER_BASE_URL="http://localhost:8000/v1"

# To keep media in Cloudflare R2 instead of on disk, set all four.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
