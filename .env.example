# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:port/dbname"
DIRECT_URL="postgresql://user:password@host:port/dbname"

# ─── Auth (NextAuth) ─────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_here"

GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ─── Clipping provider (MuAPI) ───────────────────────────────────────────────
AICLIPS_API_KEY="your_muapi_key"
# Public base URL the provider calls back on, e.g. https://clipcore.app
WEBHOOK_URL="http://localhost:3000"
# REQUIRED. Shared secret appended to the provider callback URL and verified on
# the way in. Without it /api/webhook/muapi rejects every callback (fail-closed).
# openssl rand -hex 32
MUAPI_WEBHOOK_SECRET="your_muapi_webhook_secret"

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Recurring price ids, created in the Stripe dashboard. Required — checkout
# refuses a plan whose price id is not configured, rather than guessing.
STRIPE_PRICE_BASIC="price_..."   # $9.99  / 150 credits
STRIPE_PRICE_PRO="price_..."     # $14.99 / 300 credits
STRIPE_PRICE_ULTRA="price_..."   # $29.99 / 800 credits

# ─── Object storage (Cloudflare R2, S3-compatible) ───────────────────────────
# Uploads go browser -> R2 directly via a presigned PUT; nothing streams through
# Next.js. Point R2_ENDPOINT at AWS S3 or MinIO to use those instead.
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret"
R2_BUCKET="clipcore"
# Optional: custom domain or r2.dev URL for public reads
# R2_PUBLIC_BASE_URL="https://media.yourdomain.com"
# Optional: override for S3/MinIO
# R2_ENDPOINT="https://s3.us-east-1.amazonaws.com"

# ─── Token encryption (REQUIRED for social connections) ──────────────────────
# Encrypts OAuth tokens at rest with AES-256-GCM, so a database dump does not
# hand over the ability to post to every connected channel.
# openssl rand -base64 32
ENCRYPTION_KEY="your_32_byte_base64_key"

# ─── Social publishing ───────────────────────────────────────────────────────
# YouTube. Optional: falls back to GOOGLE_CLIENT_ID/SECRET, since it is the same
# Google project. Enable the YouTube Data API v3 and add the redirect URI:
#   https://<domain>/api/social/callback/youtube
# YOUTUBE_CLIENT_ID="your_youtube_client_id"
# YOUTUBE_CLIENT_SECRET="your_youtube_client_secret"

# Not implemented yet — present so the shape is agreed in advance.
# TIKTOK_CLIENT_KEY=""
# TIKTOK_CLIENT_SECRET=""
# META_APP_ID=""          # Instagram Reels + Facebook Reels share one Meta app
# META_APP_SECRET=""

# ─── UI ──────────────────────────────────────────────────────────────────────
# One of: slate-indigo, cyberpunk, emerald, sunset, midnight
NEXT_PUBLIC_THEME=slate-indigo
