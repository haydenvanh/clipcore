# ClipCore. Copy to .env and fill in.
# Run `npm run doctor` afterwards to check everything is set.

# ─── Required ────────────────────────────────────────────────────────────────

# Postgres. A free Neon project works (neon.tech), or a local Postgres.
# DATABASE_URL is used by the app; DIRECT_URL (unpooled) by migrations.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Google sign-in. Google Cloud → APIs & Services → Credentials → Create
# credentials → OAuth client ID → Web application. Under "Authorized redirect
# URIs" add exactly:  http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# The address you open the app at (no trailing slash), and a random secret
# that signs session cookies:  openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ─── Payments (Stripe) ───────────────────────────────────────────────────────
# Dashboard → Developers → API keys. Use sk_test_… until you're ready to charge.
# Then run `npm run stripe:setup` to create the plans and prices.
STRIPE_SECRET_KEY=""
# Locally: `stripe listen --forward-to localhost:3000/api/webhook/stripe` prints
# this. In production: `npm run stripe:setup -- --webhook https://…/api/webhook/stripe`.
STRIPE_WEBHOOK_SECRET=""

# Shown on the privacy page for account-deletion requests.
# SUPPORT_EMAIL="support@yourdomain.com"

# ─── Optional ────────────────────────────────────────────────────────────────

# If YouTube blocks your server ("Sign in to confirm you're not a bot"), route
# downloads through a proxy, or give yt-dlp an exported cookies.txt.
# YTDLP_PROXY="http://user:pass@proxy.example.com:8080"
# YTDLP_COOKIES="/data/cookies.txt"

# Without any keys, everything runs locally for free: whisper.cpp transcribes
# and moments are picked from transcript signals. Each key below swaps in a
# hosted service instead.

# Claude picks the moments — judges which ones make sense on their own.
# console.anthropic.com · roughly $0.10 per hour of video.
# ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI's Whisper API transcribes instead of whisper.cpp.
# platform.openai.com/api-keys · about $0.006 per minute of video.
# OPENAI_API_KEY="sk-..."

# Local speech model and whisper.cpp binary, if not in the default places.
# WHISPER_CPP_MODEL="models/ggml-large-v3-turbo-q5_0.bin"
# WHISPER_CPP_PATH="/opt/homebrew/bin/whisper-cli"

# Where clips and source videos are stored. Defaults to ./.storage
# LOCAL_STORAGE_DIR=".storage"

# Model used to choose moments. Defaults to claude-opus-5.
# CLIPCORE_ANALYSIS_MODEL="claude-opus-5"

# Jobs processed at once. Each render is CPU-heavy; 2 suits most laptops.
# WORKER_CONCURRENCY=2

# Point transcription at a self-hosted Whisper-compatible server instead.
# WHISPER_BASE_URL="http://localhost:8000/v1"

# To keep media in Cloudflare R2 instead of on disk, set all four.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
