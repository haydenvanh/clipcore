// ClipCore — private, single-user schema.
//
//   Video -> Transcript
//         -> Clip -> Render
//   Job   (the work queue, drained with FOR UPDATE SKIP LOCKED)
//
// There is exactly one User row (id "local-owner"), created on first use by
// getOwner() in src/lib/api.js. It exists because every Video, Clip and Render
// already carries a userId; keeping one owner is a much smaller change than
// removing that column from the schema, the worker and every query.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id
  name      String?
  createdAt DateTime @default(now())

  videos  Video[]
  clips   Clip[]
  renders Render[]
}

// ─────────────────────────────── Media ──────────────────────────────────────

enum VideoSource {
  UPLOAD
  YOUTUBE
  TIKTOK
  INSTAGRAM
}

enum MediaStatus {
  PENDING
  EXTRACTING
  TRANSCRIBING
  ANALYZING
  RENDERING
  COMPLETED
  FAILED
  CANCELED
}

model Video {
  id     String @id @default(cuid())
  userId String

  source    VideoSource
  sourceUrl String?     @db.Text
  title     String?

  /// Storage key of the normalized source MP4. Null until extraction finishes.
  storageKey   String?
  thumbnailKey String?

  durationSec Int?
  sizeBytes   BigInt?
  width       Int?
  height      Int?

  status MediaStatus @default(PENDING)
  error  String?     @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript Transcript?
  clips      Clip[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Transcript {
  id      String @id @default(cuid())
  videoId String @unique

  /// ISO-639-1 code, e.g. "en".
  language String @default("en")

  text String @db.Text

  /// Word-level timings: [{ w, start, end }]. Karaoke and word-by-word
  /// captions need these; sentence-level timings cannot produce them.
  words Json?

  /// Set once the transcript has been corrected by hand, so a re-run does not
  /// silently discard the corrections.
  edited   Boolean   @default(false)
  editedAt DateTime?

  storageKey String?
  model      String?
  createdAt  DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model Clip {
  id      String @id @default(cuid())
  videoId String
  userId  String

  /// Position in the source, in seconds.
  startSec Float
  endSec   Float

  title   String?
  summary String? @db.Text
  hook    String? @db.Text

  /// 0-100.
  viralScore Float?
  clipScore  Float?
  confidence Float?

  /// Why this moment was chosen.
  reasoning String? @db.Text
  /// Per-signal breakdown: { speechIntensity, reactions, emotion, hook, topicShift, questions }
  signals Json?

  status MediaStatus @default(PENDING)
  order  Int         @default(0)

  createdAt DateTime @default(now())

  video   Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  renders Render[]

  @@index([videoId, order])
  @@index([userId, createdAt])
}

enum AspectRatio {
  RATIO_9_16
  RATIO_1_1
  RATIO_16_9
}

enum PlatformPreset {
  TIKTOK
  INSTAGRAM_REELS
  YOUTUBE_SHORTS
  X
  FACEBOOK
  CUSTOM
}

enum CaptionStyle {
  NONE
  STATIC
  ANIMATED
  KARAOKE
  WORD_BY_WORD
  TIKTOK
}

/// One exported file. A clip can render to several of these (different ratio
/// or caption style), which is why this is not a column on Clip.
model Render {
  id     String @id @default(cuid())
  clipId String
  userId String

  aspectRatio  AspectRatio    @default(RATIO_9_16)
  preset       PlatformPreset @default(TIKTOK)
  captionStyle CaptionStyle   @default(KARAOKE)
  captionLang  String         @default("en")

  /// Font, size, colours, background, position. Null = the style's preset.
  captionConfig Json?

  storageKey   String?
  thumbnailKey String?
  captionKey   String?

  width     Int?
  height    Int?
  sizeBytes BigInt?

  status MediaStatus @default(PENDING)
  error  String?     @db.Text

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clipId, aspectRatio, preset, captionStyle, captionLang])
  @@index([userId, createdAt])
  @@index([status])
}

// ─────────────────────────────── Queue ──────────────────────────────────────

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

/// Postgres-backed work queue. Workers claim rows with FOR UPDATE SKIP LOCKED,
/// so creating a Video and queueing its first job commit together.
model Job {
  id String @id @default(cuid())

  /// "extract" | "transcribe" | "analyze" | "render"
  type    String
  payload Json

  status   JobStatus @default(QUEUED)
  priority Int       @default(0)

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  /// Backoff: a retry sets this into the future.
  runAfter DateTime @default(now())

  /// Claim marker, so a reaper can release jobs from a crashed worker.
  lockedAt DateTime?
  lockedBy String?

  lastError String? @db.Text

  refType String?
  refId   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status, runAfter, priority])
  @@index([refType, refId])
  @@index([lockedAt])
}
